# ─── Domain ──────────────────────────────────────────────
DOMAIN=directmate.yourdomain.com

# ─── Database ────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=directmate

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_random_64_char_string
JWT_EXPIRES_IN=7d

# ─── Meta / Instagram ───────────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=directmate_verify_a3f7b9c2e1d4
# Instagram API with Unified Login: the Meta app's ID/secret (not the Instagram
# app's) and the configuration ID from "API setup with Unified login".
META_LOGIN_CONFIG_ID=your_unified_login_config_id
INSTAGRAM_OAUTH_REDIRECT_URI=https://directmate.yourdomain.com/auth/instagram/callback
# Instagram API with Instagram Login: the Instagram app's ID/secret from "API
# setup with Instagram login" (its secret signs that login's webhooks), and the
# login new connections use: instagram (any account) or unified.
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_LOGIN_METHOD=instagram

# ─── Encryption ──────────────────────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars

# ─── OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# The model the agent answers with; a store can override it (aiSettings.model).
AGENT_MODEL=gpt-6.1-terra
# Vision model that reads uploaded size charts into tables; defaults to ATTRIBUTES_MODEL.
SIZE_CHART_MODEL=
# The visual check of stories, posts and reels (defaults to ATTRIBUTES_MODEL)
CONTENT_VISION_MODEL=
# Customers' voice messages, transcribed for the agent (default gpt-4o-mini-transcribe)
TRANSCRIBE_MODEL=

# ─── Instagram history import ───────────────────────────
# Reads a store's recent DMs once at setup (one app-wide queue, paced by
# Meta's budget). Leave on for the API; set false on any extra replica.
HISTORY_IMPORT_WORKER_ENABLED=true

# ─── Instagram content fetch ────────────────────────────
# Reads each connected store's stories (every 30 min) and posts and reels
# (hourly) so the AI agent knows what a customer replies to. Replaces the
# n8n content workflow. Leave on for the API; set false on any extra replica.
CONTENT_FETCH_WORKER_ENABLED=true

# ─── Claude connector (MCP) ─────────────────────────────
# Owners set up their AI agent by talking to Claude: https://mcp.directmate.app/mcp.
# Before turning it on: DNS + certificate + nginx/conf.d/mcp.conf (steps in that file).
MCP_ENABLED=false
MCP_PUBLIC_URL=https://mcp.directmate.app
# The parent domain of the MCP host and the admin, for the sign-in cookie.
MCP_COOKIE_DOMAIN=directmate.app
# Test messages per store per 24 hours (admin test chat and Claude). 0 = no cap.
TEST_CHAT_DAILY_LIMIT=100

# ─── Internal API (n8n ↔ backend) ───────────────────────
INTERNAL_API_KEY=CHANGE_ME_random_string

# ─── n8n ─────────────────────────────────────────────────
N8N_DB=n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_password
N8N_ORDER_SYNC_WEBHOOK_URL=https://directmate.yourdomain.com/n8n/webhook/shopify-order-sync

# ─── Telegram ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret
TELEGRAM_BOT_USERNAME=DirectMateBot
# Founder notifications (sign-ups, Shopify connects, stores going live): your chat
# id with the bot above. Send the bot /start first or Telegram won't deliver.
PLATFORM_TELEGRAM_CHAT_ID=
# «Налаштуйте за мене» opens a chat with this Telegram username (no @).
SUPPORT_TELEGRAM_USERNAME=

# ─── FTP (Torgsoft sync, single-tenant: luxespace) ───────
# Public IPv4 the FTP server announces to clients for passive-mode data
# connections. MUST be reachable from external FTP clients (the Torgsoft
# operator's POS). Find with: curl -4 ifconfig.io
FTP_PASV_ADDRESS=
# Generated by scripts/ftp/generate-credentials.sh — do not set manually.
FTP_LUXESPACE_PASS=
