---
import Base from '../../layouts/Base.astro';
import Bubble from '../../components/chat/Bubble.astro';
import Group from '../../components/chat/Group.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import CompareTable from '../../components/compare/CompareTable.astro';
import { SITE_URL } from '../../site';

const title = 'DirectMate чи ManyChat: AI-агент чи чат-бот для Instagram | DirectMate';
const description =
  'ManyChat — конструктор сценаріїв, DirectMate — AI-агент, що відповідає з вашого каталогу. Порівняння: налаштування, ціни, сторіз, розмір, замовлення, канали.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Головна', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'DirectMate чи ManyChat', item: `${SITE_URL}/compare/manychat` },
    ],
  },
];

// The claims about ManyChat are the design's, word for word: the owner checks them.
const rows = [
  {
    label: 'Налаштування',
    other: 'Ви будуєте сценарії: тригери, кнопки, гілки',
    us: 'Підключаєте каталог і розповідаєте про магазин',
  },
  {
    label: 'Питання не за сценарієм',
    other: 'Потрібна нова гілка або AI-крок, який ви налаштовуєте окремо',
    us: 'Відповідає з каталогу й нотаток або передає менеджеру',
  },
  {
    label: 'Ціни й наявність',
    other: 'Те, що ви вписали у сценарій',
    us: 'З підключеного каталогу, з перевіркою кожної цифри',
  },
  {
    label: 'Відповідь на сторіз',
    other: 'Тригер запускає заготовлений сценарій',
    us: 'Бачить саму сторіз і знаходить товар у каталозі',
  },
  {
    label: 'Підбір розміру',
    other: 'Сценарій із кнопками, який ви складаєте самі',
    us: 'Радить за вашою розмірною сіткою',
  },
  {
    label: 'Замовлення в Direct',
    other: 'Форма зі сценарію',
    us: 'Збирає дані в розмові, ціна з каталогу',
  },
  {
    label: 'Розсилки, розіграші, збір підписників',
    other: 'Так, це його сильна сторона',
    us: 'Ні',
  },
  {
    label: 'Канали',
    other: 'Instagram, Messenger, WhatsApp, Telegram та інші',
    us: 'Лише Instagram',
  },
];

const choose = [
  {
    title: 'Обирайте ManyChat, якщо',
    highlight: false,
    items: [
      'Вам потрібні розсилки, розіграші й воронки на підписку',
      'Головний сценарій: «напиши слово в коментарі, отримай посилання»',
      'Ви працюєте в кількох месенджерах одразу',
      'Питань небагато, і всі вони вкладаються в кілька кнопок',
    ],
  },
  {
    title: 'Обирайте DirectMate, якщо',
    highlight: true,
    items: [
      'Клієнти питають про конкретні товари: ціну, колір, наявність, розмір',
      'Розмови починаються з відповідей на сторіз і дописи',
      'Ви хочете, щоб замовлення оформлювалося прямо в Direct',
      'Менеджери не встигають відповідати ввечері й у вихідні',
    ],
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="dm-page flex flex-col gap-5 pb-16 pt-12 md:pt-[72px]">
    <p class="text-base font-medium text-blue-700">Порівняння</p>
    <h1 class="dm-h1 max-w-[900px] text-[clamp(34px,4.6vw,56px)]">DirectMate чи ManyChat: що обрати магазину в Instagram</h1>
    <p class="max-w-[720px] text-[19px] leading-[1.55] text-dm-ink2 text-pretty">
      ManyChat — конструктор сценаріїв: ви малюєте гілки розмови, він іде по них. DirectMate — AI-агент: читає питання
      клієнта й відповідає з вашого каталогу. Це різні інструменти для різних задач, і нижче чесно про обидва.
    </p>
  </section>

  <!-- One question, two approaches -->
  <section class="dm-page flex flex-col gap-6 pb-16 md:pb-[88px]">
    <h2 class="text-2xl font-semibold">Одне питання клієнта, два підходи</h2>
    <div class="grid gap-6 md:grid-cols-2">
      <div class="dm-card flex flex-col gap-[18px] p-6">
        <h3 class="text-[17px] font-semibold text-dm-muted">Сценарій</h3>
        <div class="flex flex-col gap-2.5">
          <Bubble from="customer">А ця куртка є в бежевому на зріст 175?</Bubble>
          <Group side="agent">
            <Bubble from="bot" grouped>Вітаємо! Оберіть розділ:</Bubble>
            <div class="flex flex-wrap justify-end gap-1.5">
              {['Каталог', 'Доставка', 'Менеджер'].map((b) => (
                <span class="rounded-full border border-dm-line2 px-3 py-1.5 text-sm text-dm-ink2">{b}</span>
              ))}
            </div>
          </Group>
        </div>
        <p class="text-[15px] text-dm-muted">
          Сценарій працює, коли питання передбачене. Це питання гілки не має, тож клієнт чекає на менеджера.
        </p>
      </div>
      <div class="flex flex-col gap-[18px] rounded-[20px] border-2 border-blue-600 bg-white p-[23px]">
        <h3 class="text-[17px] font-semibold text-blue-700">AI-агент</h3>
        <div class="flex flex-col gap-2.5">
          <Bubble from="customer">А ця куртка є в бежевому на зріст 175?</Bubble>
          <Bubble from="agent">Бежева є в M і L. На зріст 175 радимо L. Надіслати фото?</Bubble>
        </div>
        <p class="text-[15px] text-dm-ink2">Колір і наявність з каталогу, розмір з вашої розмірної сітки. Гілок ніхто не малював.</p>
      </div>
    </div>
  </section>

  <!-- The comparison -->
  <section class="border-y border-dm-line bg-white">
    <div class="dm-page flex flex-col gap-8 py-16 md:py-20">
      <SectionHead title="Порівняння по суті" />
      <CompareTable other="ManyChat" rows={rows} />
    </div>
  </section>

  <!-- When to choose which -->
  <section class="dm-page dm-section grid gap-6 md:grid-cols-2">
    {
      choose.map((card) => (
        <div
          class:list={[
            'flex flex-col gap-4 rounded-3xl bg-white',
            card.highlight ? 'border-2 border-blue-600 p-[23px] sm:p-[31px]' : 'border border-dm-line p-6 sm:p-8',
          ]}
        >
          <h2 class="text-[26px] font-bold leading-[1.2] tracking-[-0.01em]">{card.title}</h2>
          <ul class="flex list-disc flex-col gap-2.5 pl-5 text-[17px] text-dm-ink2">
            {card.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <!-- Both in one account -->
  <section class="dm-page pb-16 md:pb-[88px]">
    <div class="flex flex-col gap-2.5 rounded-3xl bg-dm-tint p-6 sm:p-9">
      <h2 class="text-2xl font-bold leading-[1.2] tracking-[-0.01em]">А можна обидва в одному акаунті?</h2>
      <p class="max-w-[820px] text-[17px] text-dm-ink2">
        Не радимо. Відповідь, яку надіслав інший сервіс, AI-агент сприймає як відповідь менеджера й зупиняється в цій
        розмові. Якщо вам потрібні і розсилки, і AI-агент, напишіть нам: підкажемо, як розвести їх між собою.
      </p>
    </div>
  </section>

  <CtaBand
    title="Перевірте на питаннях ваших клієнтів"
    text="Напишіть демо-магазину те, що вам пишуть щодня. Або підключіть свій магазин і почніть із режиму навчання."
  >
    <a href="/#demo" class="dm-link text-[17px] text-white hover:text-dm-tint">Написати демо-магазину</a>
  </CtaBand>
</Base>
