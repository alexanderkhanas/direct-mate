---
/** Green-ticked lines (what the AI agent did in the chat above). */
interface Props {
  items: string[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<ul class:list={['flex flex-col gap-2', className]}>
  {
    items.map((item) => (
      <li class="flex items-start gap-2.5 text-[15px] text-dm-ink2">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#15803D" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mt-px shrink-0">
          <path d="M5 12.5l4.5 4.5L19 7.5" />
        </svg>
        <span>{item}</span>
      </li>
    ))
  }
</ul>
