---
/**
 * One step of the conversation on /how-it-works: the chat on the left (slot "chat": Bubble, Group, Photo, Caption),
 * then «Крок N», the step's heading and its text (default slot). Side by side from 1024 px, stacked below.
 */
interface Props {
  id: string;
  number: number;
  title: string;
}
const { id, number, title } = Astro.props;
---

<article
  id={id}
  class="grid scroll-mt-4 items-center gap-8 rounded-3xl border border-dm-line bg-white p-5 sm:p-8 lg:grid-cols-[minmax(0,420px)_minmax(0,1fr)] lg:gap-x-14"
>
  <div class="flex w-full min-w-0 max-w-[420px] flex-col gap-2.5 rounded-[20px] border border-dm-line bg-dm-sunken p-4 sm:p-5">
    <slot name="chat" />
  </div>
  <div class="flex min-w-0 flex-col gap-3">
    <p class="text-[15px] font-semibold text-blue-700">Крок {number}</p>
    <h2 class="text-2xl font-bold leading-[1.2] tracking-[-0.01em] sm:text-[28px]">{title}</h2>
    <slot />
  </div>
</article>
