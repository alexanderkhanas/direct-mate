---
/**
 * The legal pages (/privacy, /terms, /data-deletion): English, one readable column on a white card.
 * Meta's app settings link to them, so their addresses and text stay as they are.
 * Pages write plain <section>, <h2>, <h3>, <p>, <ul>, <a>, <strong>; the styles below dress them.
 */
import Base from '../../layouts/Base.astro';

interface Props {
  /** The page's heading; the browser title adds « | DirectMate». */
  heading: string;
  description: string;
  /** «April 16, 2026» */
  effective: string;
}

const { heading, description, effective } = Astro.props;
---

<Base title={`${heading} | DirectMate`} description={description} lang="en">
  <div class="mx-auto w-full max-w-[808px] px-5 pb-16 pt-6 sm:px-6 md:pb-24 md:pt-8">
    <a href="/" class="inline-flex min-h-[44px] items-center gap-1.5 text-[15px] text-dm-muted no-underline hover:text-dm-ink">
      <span aria-hidden="true">←</span> DirectMate
    </a>

    <header class="mb-8 mt-4 md:mb-10">
      <h1 class="text-balance text-[32px] font-bold leading-[1.12] tracking-[-0.02em] sm:text-[40px]">{heading}</h1>
      <p class="mt-3 text-[15px] text-dm-muted">Effective date: {effective}</p>
    </header>

    <article class="legal-prose dm-card px-5 py-8 sm:px-10 sm:py-10">
      <slot />
    </article>
  </div>
</Base>

<style>
  .legal-prose {
    overflow-wrap: break-word;
  }
  .legal-prose :global(section) {
    @apply border-b border-dm-line py-8 first:pt-0 last:border-0 last:pb-0;
  }
  .legal-prose :global(h2) {
    @apply mb-3 text-xl font-semibold leading-snug text-dm-ink;
  }
  .legal-prose :global(h3) {
    @apply mb-2 mt-6 text-base font-semibold text-dm-ink;
  }
  .legal-prose :global(p),
  .legal-prose :global(ul) {
    @apply mb-3 text-base leading-[1.65] text-dm-ink2 last:mb-0;
  }
  .legal-prose :global(ul) {
    @apply list-disc pl-5;
  }
  /* Not space-y / marker: (their child selectors would get this component's scope, which slotted <li> lack). */
  .legal-prose :global(li + li) {
    @apply mt-1.5;
  }
  .legal-prose :global(li::marker) {
    @apply text-dm-faint;
  }
  .legal-prose :global(strong) {
    @apply font-semibold text-dm-ink;
  }
  .legal-prose :global(a) {
    @apply text-blue-700 underline underline-offset-2 hover:text-blue-800;
  }
  /* The address on /data-deletion, set apart. */
  .legal-prose :global(.legal-email) {
    @apply mt-4 text-lg font-medium text-dm-ink;
  }
</style>
