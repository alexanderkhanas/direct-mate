# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/directmate

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Meta / Instagram
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET_OAUTH=
# Background Instagram jobs (default on): the setup history import, and the
# content fetch (stories every 30 min, posts and reels hourly).
HISTORY_IMPORT_WORKER_ENABLED=true
CONTENT_FETCH_WORKER_ENABLED=true
# The visual check (stories, posts and reels vs catalog photos, once each); defaults to ATTRIBUTES_MODEL.
CONTENT_VISION_MODEL=
CONTENT_VISION_REASONING_EFFORT=low
# Customers' voice messages, transcribed for the agent.
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Internal
INTERNAL_API_KEY=change-me-internal-key

# CLIP image embeddings (Replicate API — see image-embedding.service.ts)
CLIP_ENABLED=false
REPLICATE_API_TOKEN=
# Pinned krthr/clip-embeddings version (CLIP ViT-B/32, 512-dim).
# Bump deliberately — a new variant could shift output space.
REPLICATE_CLIP_MODEL_VERSION=1c0371070cb827ec3c7f2f28adcdde54b50dcd239aa6faea0bc98b174ef03fb4
# The Claude connector (remote MCP server): owners set up their AI agent by
# talking to Claude. Off by default. MCP_PUBLIC_URL is the public origin of the
# MCP host (ngrok in development); owners paste `${MCP_PUBLIC_URL}/mcp`.
MCP_ENABLED=false
MCP_PUBLIC_URL=http://localhost:3000
# Production: the parent domain shared by the MCP host and the admin (directmate.app).
MCP_COOKIE_DOMAIN=
# Development and test only: a static bearer token for one tenant (MCP Inspector, curl).
MCP_DEV_TENANT_ID=
MCP_DEV_TOKEN=
# Test messages per store per 24 hours (admin test chat and Claude's try_agent). 0 = no cap.
TEST_CHAT_DAILY_LIMIT=100
